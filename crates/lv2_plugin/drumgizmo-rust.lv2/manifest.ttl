# SPDX-License-Identifier: GPL-3.0-or-later
# LV2 bundle manifest for drumgizmo-rust.
# Install this whole directory (with the compiled libdg_lv2_plugin.so)
# into any LV2_PATH entry, e.g. ~/.ladspa or /usr/lib/lv2.
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://github.com/Pliexi/drumgizmo-rust/lv2>
    a lv2:Plugin ;
    lv2:binary <libdg_lv2_plugin.so> ;
    rdfs:seeAlso <drumgizmo-rust.ttl> .
